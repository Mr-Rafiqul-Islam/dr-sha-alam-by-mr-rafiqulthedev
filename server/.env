NODE_ENV=development
PORT=5007

# Cors Options
CORS_ORIGIN=http://localhost:3000,https://doctorshahalam.com,https://www.doctorshahalam.com
CORS_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization
CORS_ALLOWED_CREDENTIALS=true
CORS_MAX_AGE=86400
CORS_OPTIONS_SUCCESS_STATUS=200

# Database URL
DATABASE_URL="postgresql://thesakibdev:thesakibdev@123@localhost:5432/drsa?schema=public"


# JWT Secret Keys
JWT_SECRET=your-secret-key
JWT_EXPIRES_IN=30d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d