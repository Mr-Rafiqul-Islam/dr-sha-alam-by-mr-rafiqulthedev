generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  PATIENT
  DOCTOR
  EDITOR
}

enum AppointmentStatus {
  PENDING
  ATTEND
  CANCEL
  RESCHEDULED
  CONFIRMED
}

enum SiteRef {
  DOCTOR_SHA_ALAM
  TRUE_CARE_HELLING_CENTER
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
  ON_HOLD
  EXPIRED
  UNATTEMPTED
}

enum PaymentProvider {
  BKASH
  SSL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum AttendTime {
  M10
  A03
  A05
}

enum MuxVideoStatus {
  PROCESSING
  READY
  ERROR
}

enum PatientReviewStatus {
  PENDING
  ACTIVE
}

model User {
  id         String   @id @default(uuid())
  name       String?
  email      String?  @unique
  phone      String?
  image      String?
  password   String? // OAuth হলে password null থাকবে
  provider   String? // যেমন: "google", "github"
  providerId String? // OAuth user এর unique id
  role       UserRole @default(PATIENT)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  payments       Payment[]
  patientReviews PatientReview[]
  doctorId       String?

  @@index([role])
}

model Doctor {
  id              String   @id @default(uuid())
  name            String
  avatar          String?
  specialization  String
  about           String?
  experience      Int?
  consultationFee Float?
  location        String?
  availableDays   String? // উদাহরণ: "Sat, Sun, Mon"
  startTime       String? // উদাহরণ: "09:00 AM"
  endTime         String? // উদাহরণ: "05:00 PM"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payments Payment[]

  @@index([specialization])
  @@index([location])
}

model Appointment {
  id              String            @id @default(uuid())
  name            String
  phone           String
  email           String?
  homeAddress     String
  problem         String?
  preferredTime   String
  appointmentDate DateTime
  serialNumber    Int
  gender          String?
  status          AppointmentStatus @default(PENDING)
  siteRef         SiteRef           @default(DOCTOR_SHA_ALAM)
  transactionId   String?           @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentDate])
}

model Payment {
  id       String        @id @default(uuid())
  tranId   String        @unique
  amount   Float
  currency String        @default("BDT")
  status   PaymentStatus @default(PENDING)

  transactionId String? @unique @map("transaction_id")

  gateway         String?
  valId           String?
  gatewayResponse Json?

  userId        String?
  doctorId      String?
  appointmentId String?

  providerStatus       String?
  providerStatusReason String?
  providerValId        String?
  providerRaw          Json?
  paymentResolvedAt    DateTime?
  failedAt             DateTime?
  cancelledAt          DateTime?
  expiredAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user   User?   @relation(fields: [userId], references: [id])
  doctor Doctor? @relation(fields: [doctorId], references: [id])
  // appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([tranId])
  @@index([userId])
  @@index([doctorId])
}

model Blog {
  id         String   @id @default(uuid())
  title      String
  shortDesc  String
  content    String
  category   String
  author     String
  views      Int      @default(0)
  comments   String[] @default([])
  isFeatured Boolean
  slug       String   @unique
  meta       Json?    @default("{}")
  notes      Json?
  published  Boolean  @default(false)

  image         String
  imagePublicId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
  @@index([category])
}

model PatientReview {
  id        String              @id @default(uuid())
  status    PatientReviewStatus @default(PENDING)
  sortOrder Int                 @default(0)

  authorUserId String?
  author       User?   @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  patientDisplayName String?
  title              String
  description        String
  rating             Int

  imageUrl      String?
  imagePublicId String?

  muxUploadId          String?
  mediaAssetId         String?
  muxPlaybackId        String?
  muxPlaybackPolicy    String?         @default("public")
  muxVideoStatus       MuxVideoStatus?
  videoThumbnailUrl    String?
  videoDurationSeconds Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
  @@index([authorUserId])
}

model SuccessStory {
  id        String              @id @default(uuid())
  status    PatientReviewStatus @default(PENDING)
  sortOrder Int                 @default(0)

  patientName   String
  patientReview String

  age        Int
  rating     Int
  problems   String[] @default([])
  treatments String[] @default([])
  result     String

  imageUrl      String?
  imagePublicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
}

model Purchase {
  id            String  @id @default(uuid())
  userId        String
  productId     String
  transactionId String? @unique @map("transaction_id")

  provider PaymentProvider
  status   PurchaseStatus  @default(PENDING)

  amount   Int
  currency String @default("BDT")

  merchantInvoiceNumber String? @unique

  /// bKash mapping
  providerPaymentId String? @unique
  providerTrxId     String? @unique

  providerStatus       String?
  providerStatusReason String?
  providerValId        String?
  providerRaw          Json?
  paymentResolvedAt    DateTime?
  failedAt             DateTime?
  cancelledAt          DateTime?
  expiredAt            DateTime?

  paidAt DateTime?
  meta   Json?

  // user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Admin tracking (who processed/managed this purchase)
  processedByAdminId String?
  // processedByAdmin   Admin?  @relation(fields: [processedByAdminId], references: [id], onDelete: SetNull)
  // @@index([processedByAdminId])

  @@index([userId, productId])
  @@index([status])
  @@index([provider])
  @@index([providerStatus])
  @@index([providerValId])
}
