generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  MANAGER
  PATIENT
  DOCTOR
  SUPPORT
}

enum AppointmentStatus {
  PENDING
  ATTEND
  CANCEL
  RESCHEDULED
  CONFIRMED
}

enum AppointmentPaymentStatus {
  PENDING
  SUCCESS
  CANCEL
}

enum SiteRef {
  DOCTOR_SHA_ALAM
  TRUE_CARE_HELLING_CENTER
}

enum PurchaseStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELED
  ON_HOLD
  EXPIRED
  UNATTEMPTED
}

enum PaymentProvider {
  BKASH
  SSL
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum AttendTime {
  M10
  A03
  A05
}

enum MuxVideoStatus {
  PROCESSING
  READY
  ERROR
}

enum PatientReviewStatus {
  PENDING
  ACTIVE
}

enum ContactMessageStatus {
  PENDING
  IN_PROGRESS
  READ
}

enum ScheduleStatus {
  ACTIVE
  INACTIVE
}

enum DeleteRequestEntityType {
  BLOG
  APPOINTMENT
  CONTACT_MESSAGE
}

enum DeleteRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ActivityAction {
  APPOINTMENT_CREATED
  APPOINTMENT_STATUS_CHANGED
  APPOINTMENT_DELETED
  CONTACT_MESSAGE_STATUS_CHANGED
  CONTACT_MESSAGE_DELETED
  BLOG_CREATED
  BLOG_UPDATED
  BLOG_DELETED
  BLOG_FEATURED_CHANGED
  BLOG_IMAGE_UPLOADED
  BLOG_IMAGE_DELETED
  SCHEDULE_CREATED
  SCHEDULE_UPDATED
  SCHEDULE_DELETED
  SLOT_DEFAULTS_UPDATED
}

enum ActivityEntityType {
  Appointment
  ContactMessage
  Blog
  AppointmentSchedule
  AppointmentSlotDefaultConfig
}

model User {
  id         String   @id @default(uuid())
  name       String?
  email      String?  @unique
  phone      String?
  image      String?
  password   String? // OAuth হলে password null থাকবে
  provider   String? // যেমন: "google", "github"
  providerId String? // OAuth user এর unique id
  role       UserRole @default(ADMIN)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  payments                Payment[]
  patientReviews          PatientReview[]
  activityLogs            ActivityLog[]
  deleteRequestsRequested DeleteRequest[] @relation("DeleteRequestsRequested")
  deleteRequestsReviewed  DeleteRequest[] @relation("DeleteRequestsReviewed")
  doctorId                String?

  @@index([role])
}

model DeleteRequest {
  id            String                  @id @default(uuid())
  entityType    DeleteRequestEntityType
  entityId      String
  status        DeleteRequestStatus     @default(PENDING)
  requestedById String
  requestedBy   User                    @relation("DeleteRequestsRequested", fields: [requestedById], references: [id])
  reviewedById  String?
  reviewedBy    User?                   @relation("DeleteRequestsReviewed", fields: [reviewedById], references: [id])
  requestedAt   DateTime                @default(now())
  reviewedAt    DateTime?

  @@index([status, entityType])
  @@index([entityType, entityId])
}

model ActivityLog {
  id         String             @id @default(uuid())
  actorId    String
  actorRole  UserRole
  action     ActivityAction
  entityType ActivityEntityType
  entityId   String?
  summary    String
  metadata   Json?
  createdAt  DateTime           @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([actorId, createdAt])
  @@index([createdAt])
  @@index([entityType, entityId])
}

model Doctor {
  id              String   @id @default(uuid())
  name            String
  avatar          String?
  specialization  String
  about           String?
  experience      Int?
  consultationFee Float?
  location        String?
  availableDays   String? // উদাহরণ: "Sat, Sun, Mon"
  startTime       String? // উদাহরণ: "09:00 AM"
  endTime         String? // উদাহরণ: "05:00 PM"
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  payments Payment[]

  @@index([specialization])
  @@index([location])
}

model Appointment {
  id              String            @id @default(uuid())
  name            String
  phone           String
  email           String?
  homeAddress     String
  problem         String?
  preferredTime   String
  appointmentDate DateTime
  serialNumber    Int
  gender          String?
  status          AppointmentStatus @default(PENDING)
  paymentStatus   AppointmentPaymentStatus?
  siteRef         SiteRef           @default(DOCTOR_SHA_ALAM)
  transactionId   String?           @unique
  scheduleId      String?
  slotId          String?

  schedule AppointmentSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  slot     AppointmentSlot?     @relation(fields: [slotId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([appointmentDate])
  @@index([scheduleId])
  @@index([slotId])
  @@index([appointmentDate, preferredTime, siteRef, status])
}

model AppointmentSchedule {
  id       String         @id @default(uuid())
  siteRef  SiteRef        @default(DOCTOR_SHA_ALAM)
  status   ScheduleStatus @default(ACTIVE)
  title    String?
  date     String
  isClosed Boolean        @default(false)

  slots        AppointmentSlot[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([siteRef, date])
  @@index([siteRef, date, status])
}

model AppointmentSlot {
  id         String @id @default(uuid())
  scheduleId String

  code      String
  label     String
  smsLabel  String?
  startTime String
  endTime   String?

  seatLimit Int
  isActive  Boolean @default(true)

  schedule     AppointmentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([scheduleId, code])
  @@index([scheduleId, isActive])
}

model AppointmentSlotDefaultConfig {
  id               String   @id @default(uuid())
  siteRef          SiteRef  @unique
  defaultSeatLimit Int      @default(50)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  slots AppointmentSlotDefault[]
}

model AppointmentSlotDefault {
  id       String @id @default(uuid())
  configId String

  code      String
  label     String
  smsLabel  String?
  startTime String
  endTime   String?
  seatLimit Int
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  config AppointmentSlotDefaultConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([configId, code])
  @@index([configId, isActive])
}

model Payment {
  id       String        @id @default(uuid())
  tranId   String        @unique
  amount   Float
  currency String        @default("BDT")
  status   PaymentStatus @default(PENDING)

  transactionId String? @unique @map("transaction_id")

  gateway         String?
  valId           String?
  gatewayResponse Json?
  meta            Json?

  userId        String?
  doctorId      String?
  appointmentId String?

  providerStatus       String?
  providerStatusReason String?
  providerValId        String?
  providerRaw          Json?
  paymentResolvedAt    DateTime?
  failedAt             DateTime?
  cancelledAt          DateTime?
  expiredAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user   User?   @relation(fields: [userId], references: [id])
  doctor Doctor? @relation(fields: [doctorId], references: [id])
  // appointment Appointment? @relation(fields: [appointmentId], references: [id])

  @@index([tranId])
  @@index([userId])
  @@index([doctorId])
}

model Blog {
  id         String   @id @default(uuid())
  title      String
  shortDesc  String
  content    String
  category   String[] @default([])
  author     String[] @default([])
  views      Int      @default(0)
  comments   String[] @default([])
  isFeatured Boolean  @default(false)
  slug       String   @unique
  meta       Json?    @default("{}")
  notes      Json?
  published  Boolean  @default(false)

  image         String
  imagePublicId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}

model PatientReview {
  id        String              @id @default(uuid())
  status    PatientReviewStatus @default(PENDING)
  sortOrder Int                 @default(0)

  authorUserId String?
  author       User?   @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  patientDisplayName String?
  title              String
  description        String
  rating             Int

  imageUrl      String?
  imagePublicId String?

  muxUploadId          String?
  mediaAssetId         String?
  muxPlaybackId        String?
  muxPlaybackPolicy    String?         @default("public")
  muxVideoStatus       MuxVideoStatus?
  videoThumbnailUrl    String?
  videoDurationSeconds Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
  @@index([authorUserId])
}

model SuccessStory {
  id        String              @id @default(uuid())
  status    PatientReviewStatus @default(PENDING)
  sortOrder Int                 @default(0)

  patientName   String
  patientReview String

  age        Int
  rating     Int
  problems   String[] @default([])
  treatments String[] @default([])
  result     String

  imageUrl      String?
  imagePublicId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, sortOrder])
}

model Purchase {
  id            String  @id @default(uuid())
  userId        String
  productId     String
  transactionId String? @unique @map("transaction_id")

  provider PaymentProvider
  status   PurchaseStatus  @default(PENDING)

  amount   Int
  currency String @default("BDT")

  merchantInvoiceNumber String? @unique

  /// bKash mapping
  providerPaymentId String? @unique
  providerTrxId     String? @unique

  providerStatus       String?
  providerStatusReason String?
  providerValId        String?
  providerRaw          Json?
  paymentResolvedAt    DateTime?
  failedAt             DateTime?
  cancelledAt          DateTime?
  expiredAt            DateTime?

  paidAt DateTime?
  meta   Json?

  // user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Admin tracking (who processed/managed this purchase)
  processedByAdminId String?
  // processedByAdmin   Admin?  @relation(fields: [processedByAdminId], references: [id], onDelete: SetNull)
  // @@index([processedByAdminId])

  @@index([userId, productId])
  @@index([status])
  @@index([provider])
  @@index([providerStatus])
  @@index([providerValId])
}

model ContactMessage {
  id     String               @id @default(uuid())
  status ContactMessageStatus @default(PENDING)

  name  String
  email String?
  phone String

  subject String
  message String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([phone])
}

model AnalyticsSetting {
  id            String  @id @default(uuid())
  isSingleton   Boolean @unique @default(true)
  pixelId       String?
  accessToken   String?
  testEventCode String?
  enabled       Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
