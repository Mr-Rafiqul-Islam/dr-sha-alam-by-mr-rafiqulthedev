# Copy to .env and fill in values. Server runs from this directory (server/).

# PostgreSQL — required for Prisma (migrate, generate, runtime)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dr_sha_alam?schema=public"

# HTTP
PORT=5002
NODE_ENV=development
BACKEND_URL=http://localhost:5002
FRONTEND_URL=http://localhost:3000
# Optional comma-separated extra CORS origins (e.g. ngrok URLs)
# CORS_ALLOWED_ORIGINS=

# Seed (prisma/seed.js) — if unset, seed uses documented dev-only defaults per role; use strong secrets in production
# Re-running seed updates listed staff users so each role keeps its own password (SUPER_ADMIN / EDITOR / SUPPORT / CHAMBER)
# SUPER_ADMIN_SEED_PASSWORD=
# EDITOR_SEED_PASSWORD=
# SUPPORT_SEED_PASSWORD=
# CHAMBER_SEED_PASSWORD=

# --- Optional / future (packages present; wire when needed) ---

# Required for admin dashboard JWT auth
JWT_SECRET=

# Optional admin token lifetime (default: 7d). Cookie maxAge matches this value.
# ADMIN_ACCESS_TOKEN_EXPIRY=7d

# Appointment booking — uuid of the default Doctor row (see prisma db seed output)
# DEFAULT_DOCTOR_ID=

# Daily leftover close to NOT_ATTENDED (Doctor Sha Alam). First Dhaka YYYY-MM-DD this job may close.
# Job runs at 06:00 Asia/Dhaka and catch-up on boot. Unset or invalid = job no-ops.
# APPOINTMENT_DAY_AUTOCLOSE_FROM=2026-08-24

# NOVOCOM SMS (appointment confirmation)
# NOVOCOM_API_KEY=
# NOVOCOM_CLIENT_ID=
# NOVOCOM_SENDER_ID=

# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=

# SSLCommerz payment gateway
# Sandbox (local dev): register at https://developer.sslcommerz.com/registration/
# or use the public test store — store_id=testbox, store_passwd=qwerty, SSL_IS_LIVE=false
# SSLCOMMERZ_STORE_ID=testbox
# SSLCOMMERZ_STORE_PASSWORD=qwerty
# SSL_IS_LIVE=false
# SKIP_SSL_VALIDATION=false

# Payment defaults
# CONSULTATION_FEE_FALLBACK=500

# Appointment revenue fee seed (prisma/seed.js) — defaults when unset:
# NEW_PLID 1500, OLD_PLID 1000, GENERAL 600, OLD_GENERAL 400
# NEW_PLID_APPOINTMENT_FEE=1500
# OLD_PLID_APPOINTMENT_FEE=1000
# GENERAL_APPOINTMENT_FEE=600
# OLD_GENERAL_APPOINTMENT_FEE=400

# Analytics appointment seed (optional — off by default)
# SEED_APPOINTMENTS=true          # run with npm run prisma:seed
# SEED_APPOINTMENTS_FORCE=true    # delete and re-create seed appointments
# Or run standalone: npm run prisma:seed:appointments

# Trucare appointment sync
# TRUCARE_API_BASE_URL=http://72.62.197.57:8090/ords/trucareapi/api
# TRUCARE_X_API_KEY=
# DEBUG_TRUCARE=false


