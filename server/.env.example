# Copy to .env and fill in values. Server runs from this directory (server/).

# PostgreSQL — required for Prisma (migrate, generate, runtime)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/dr_sha_alam?schema=public"

# HTTP
PORT=5002
NODE_ENV=development
BACKEND_URL=http://localhost:5002
FRONTEND_URL=http://localhost:3000
# Optional comma-separated extra CORS origins (e.g. ngrok URLs)
# CORS_ALLOWED_ORIGINS=

# Seed (prisma/seed.js) — if unset, seed uses a documented dev-only default; use a strong secret in production
# Creates: superadmin@example.com (SUPER_ADMIN), admin@example.com (ADMIN), and other staff admins
ADMIN_SEED_PASSWORD=

# --- Optional / future (packages present; wire when needed) ---

# Required for admin dashboard JWT auth
JWT_SECRET=

# Optional admin token lifetime (default: 7d). Cookie maxAge matches this value.
# ADMIN_ACCESS_TOKEN_EXPIRY=7d

# Appointment booking — uuid of the default Doctor row (see prisma db seed output)
# DEFAULT_DOCTOR_ID=

# NOVOCOM SMS (appointment confirmation)
# NOVOCOM_API_KEY=
# NOVOCOM_CLIENT_ID=
# NOVOCOM_SENDER_ID=

# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=

# SSLCommerz payment gateway
# Sandbox (local dev): register at https://developer.sslcommerz.com/registration/
# or use the public test store — store_id=testbox, store_passwd=qwerty, SSL_IS_LIVE=false
# SSLCOMMERZ_STORE_ID=testbox
# SSLCOMMERZ_STORE_PASSWORD=qwerty
# SSL_IS_LIVE=false
# SKIP_SSL_VALIDATION=false

# Payment defaults
# CONSULTATION_FEE_FALLBACK=500
