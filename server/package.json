{
  "name": "drsa-server",
  "version": "1.0.0",
  "description": "Doctor Sha Alam Appointment Server",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/app.ts --watch src",
    "build": "tsc",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "start": "node dist/app.js",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:resolve": "prisma migrate resolve",
    "prisma:diff": "prisma migrate diff",
    "prisma:reset": "prisma migrate reset",
    "prisma:push": "prisma db push",
    "test:otp": "tsx scripts/test-otp-send.ts"
  },
  "keywords": [
    "doctor",
    "sha",
    "alam",
    "appointment",
    "server"
  ],
  "author": "Dr Md Shah Alam",
  "license": "",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "7.7.0",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-cache": "^5.1.2",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "nodemon": "^3.1.14",
    "prisma": "7.7.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@hono/node-server": "1.19.13"
  }
