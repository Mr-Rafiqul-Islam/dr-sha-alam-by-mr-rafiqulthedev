{
  "name": "drsa-server",
  "version": "1.0.0",
  "description": "Doctor Sha Alam Appointment Server",
  "main": "index.js",
  "scripts": {
    "dev": "nodemon --exec tsx src/app.ts --watch src",
    "build": "tsc",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "start": "node dist/app.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:force": "prisma db push --force-reset",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "test:otp": "tsx scripts/test-otp-send.ts"
  },
  "keywords": [
    "doctor",
    "sha",
    "alam",
    "appointment",
    "server"
  ],
  "author": "Dr Md Shah Alam",
  "license": "",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.9.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "node-cache": "^5.1.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
