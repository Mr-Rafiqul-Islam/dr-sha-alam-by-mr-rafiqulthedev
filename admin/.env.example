# Copy to admin/.env for local development.

# Leave empty in dev to call /api via the Vite proxy (recommended).
# For production builds, set the public API origin, e.g. https://api.example.com
VITE_API_URL=

# Backend target for the dev-only Vite proxy (/api -> server).
# Must match server PORT in server/.env (default 5002 in server/.env.example).
VITE_DEV_API_PROXY=http://localhost:5002

# Required for the article editor in production; optional in local dev.
VITE_TINYMCE_API_KEY=dvpt6yrghqn11su5e7uutgqqjqrvjq3l1khrnit4hkgv762u
